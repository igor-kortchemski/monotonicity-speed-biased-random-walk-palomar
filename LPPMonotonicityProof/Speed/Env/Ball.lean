module

public import LPPMonotonicityProof.Speed.Env.Concrete
public import Mathlib.MeasureTheory.Function.FactorsThrough
public import Mathlib.Probability.Martingale.Convergence
public import Mathlib.Probability.Process.Filtration

/-!
# Finite marked-ball observables on ordered environments

A radius-`r` observable reads the forward pruned tree to
address depth at most `r`, the backward pruned tree to depth strictly below
`r`, and the first `r` ray entries.  There are no raw-field coordinates or
root labels.  The resulting filtration generates the product measurable
structure on `Env`, and conditional expectations give the L¹ approximation
used to show that the invariant future probability factors through the forward
tree (`Speed/Ergodic/G3.lean`).
-/

@[expose] public section

namespace LPPMonotonicityProof.Speed

open LPPMonotonicityProof.RTL.LocallyFinite
open MeasureTheory Filter
open scoped ENNReal Topology

/-- The finite data read by a radius-`r` marked-ball observable. -/
abbrev BallData (r : ℕ) :=
  ({u : List ℕ // u.length ≤ r} → ℕ) ×
    ({u : List ℕ // u.length < r} → ℕ) × (Fin r → ℕ)

/-- Restriction of marked-ball data to a smaller radius. -/
def ballDataRestrict {r s : ℕ} (hrs : r ≤ s) (b : BallData s) : BallData r :=
  (fun u => b.1 ⟨u.1, u.2.trans hrs⟩,
    fun u => b.2.1 ⟨u.1, u.2.trans_le hrs⟩,
    fun j => b.2.2 (Fin.castLE hrs j))

/-- The finite marked ball of radius `r`, using only pruned trees. -/
def ballMap (r : ℕ) (e : Env) : BallData r :=
  (fun u => e.fwd.val u, fun u => e.bwd.val u, fun j => e.ray j)

@[simp] theorem ballDataRestrict_ballMap {r s : ℕ} (hrs : r ≤ s) (e : Env) :
    ballDataRestrict hrs (ballMap s e) = ballMap r e := rfl

theorem measurable_ballDataRestrict {r s : ℕ} (hrs : r ≤ s) :
    Measurable (ballDataRestrict hrs) := by
  refine (measurable_pi_iff.mpr fun (u : {u : List ℕ // u.length ≤ r}) => ?_).prodMk ?_
  · exact (measurable_pi_apply (⟨u.1, u.2.trans hrs⟩ :
      {u : List ℕ // u.length ≤ s})).comp measurable_fst
  · refine (measurable_pi_iff.mpr fun (u : {u : List ℕ // u.length < r}) => ?_).prodMk
      (measurable_pi_iff.mpr fun (j : Fin r) => ?_)
    · exact (measurable_pi_apply (⟨u.1, u.2.trans_le hrs⟩ :
        {u : List ℕ // u.length < s})).comp measurable_snd.fst
    · exact (measurable_pi_apply (Fin.castLE hrs j)).comp measurable_snd.snd

theorem measurable_ballMap (r : ℕ) : Measurable (ballMap r) := by
  refine (measurable_pi_iff.mpr fun u => ?_).prodMk ?_
  · exact (continuous_offspring u.1).measurable.comp measurable_fst
  · refine (measurable_pi_iff.mpr fun u => ?_).prodMk
      (measurable_pi_iff.mpr fun j => ?_)
    · exact (continuous_offspring u.1).measurable.comp measurable_snd.fst
    · exact (measurable_pi_apply j.1).comp measurable_snd.snd

/-- The filtration generated by finite marked balls. -/
def ballFiltration : Filtration ℕ (inferInstance : MeasurableSpace Env) where
  seq r := MeasurableSpace.comap (ballMap r) inferInstance
  mono' _r _s hrs := MeasurableSpace.comap_le_comap_of_eq_comp
    (ballDataRestrict hrs) (measurable_ballDataRestrict hrs)
    (funext fun e => (ballDataRestrict_ballMap hrs e).symm)
  le' r := (measurable_ballMap r).comap_le

theorem measurable_ballMap_ballFiltration (r : ℕ) :
    Measurable[ballFiltration r] (ballMap r) :=
  fun _s hs => ⟨_s, hs, rfl⟩

theorem measurable_ballMap_iSup (r : ℕ) :
    @Measurable Env (BallData r) (⨆ r, ballFiltration r) _ (ballMap r) :=
  (measurable_ballMap_ballFiltration r).mono (le_iSup (fun r => ballFiltration r) r) le_rfl

/-- Finite marked balls generate the measurable structure on `Env`.
Consequently this is also the measurable structure over which `ref`, `muW`,
and `muU` are defined; their equivalences in `Masses.lean` need no change of
σ-field. -/
theorem iSup_ballFiltration :
    ⨆ r, ballFiltration r = (inferInstance : MeasurableSpace Env) := by
  apply le_antisymm
  · exact iSup_le fun r => (measurable_ballMap r).comap_le
  · let _ : MeasurableSpace Env := ⨆ r, ballFiltration r
    have hfwd : Measurable (fun e : Env => e.fwd) := by
      apply Measurable.subtype_mk
      apply measurable_pi_iff.mpr
      intro u
      have hfirst : Measurable (fun e : Env => (ballMap u.length e).1) :=
        measurable_fst.comp (measurable_ballMap_iSup u.length)
      exact measurable_pi_iff.mp hfirst ⟨u, le_rfl⟩
    have hbwd : Measurable (fun e : Env => e.bwd) := by
      apply Measurable.subtype_mk
      apply measurable_pi_iff.mpr
      intro u
      have hsecond : Measurable (fun e : Env => (ballMap (u.length + 1) e).2.1) :=
        measurable_snd.fst.comp (measurable_ballMap_iSup (u.length + 1))
      exact measurable_pi_iff.mp hsecond ⟨u, Nat.lt_succ_self u.length⟩
    have hray : Measurable (fun e : Env => e.ray) := by
      apply measurable_pi_iff.mpr
      intro j
      have hthird : Measurable (fun e : Env => (ballMap (j + 1) e).2.2) :=
        measurable_snd.snd.comp (measurable_ballMap_iSup (j + 1))
      exact measurable_pi_iff.mp hthird ⟨j, Nat.lt_succ_self j⟩
    have hid : @Measurable Env Env (⨆ r, ballFiltration r)
        (@Prod.instMeasurableSpace Tree (Tree × (ℕ → ℕ)) inferInstance inferInstance) id :=
      hfwd.prodMk (hbwd.prodMk hray)
    simpa using hid.comap_le

/-- The environment reached after `n` outward Q-moves. -/
noncomputable def outIter (l : ℝ) (hl : 0 < l) (e : Env) (c : ℕ → ℕ) (n : ℕ) : Env :=
  (qSpec l hl).state e c n

theorem outIter_fwd (l : ℝ) (hl : 0 < l) (e : Env) (c : ℕ → ℕ) (n : ℕ) :
    (outIter l hl e c n).fwd = rayTree e.fwd c n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      change child (outIter l hl e c n).fwd (c n) = child (rayTree e.fwd c n) (c n)
      rw [ih]

theorem outIter_ray_of_lt (l : ℝ) (hl : 0 < l) (e : Env) (c : ℕ → ℕ)
    {n j : ℕ} (hj : j < n) :
    (outIter l hl e c n).ray j = c (n - 1 - j) := by
  induction n generalizing j with
  | zero => simp at hj
  | succ n ih =>
      cases j with
      | zero => simp [outIter, Markov.LabelSpec.state, qSpec, outward, Env.ray]
      | succ j =>
          have hjn : j < n := by omega
          change (outIter l hl e c n).ray j = c (n + 1 - 1 - (j + 1))
          rw [ih hjn]
          congr 1
          omega

theorem outIter_bwd_offspring (l : ℝ) (hl : 0 < l) (c : ℕ → ℕ) {r n : ℕ} (hrn : r ≤ n)
    (e e' : Env) (h : e.fwd = e'.fwd) {u : List ℕ} (hu : u.length < r) :
    (outIter l hl e c n).bwd.val u = (outIter l hl e' c n).bwd.val u := by
  induction n generalizing r u with
  | zero => omega
  | succ n ih =>
      have hfwd : (outIter l hl e c n).fwd = (outIter l hl e' c n).fwd := by
        rw [outIter_fwd, outIter_fwd, h]
      change (replaceChild (outIter l hl e c n).fwd (c n)
        (outIter l hl e c n).bwd).val u =
        (replaceChild (outIter l hl e' c n).fwd (c n)
        (outIter l hl e' c n).bwd).val u
      by_cases hi : 1 ≤ c n ∧ c n ≤ degree (outIter l hl e c n).fwd
      · have hi' : 1 ≤ c n ∧ c n ≤ degree (outIter l hl e' c n).fwd := by
          rwa [← hfwd]
        cases u with
        | nil =>
            change degree (replaceChild (outIter l hl e c n).fwd (c n)
              (outIter l hl e c n).bwd) = degree
              (replaceChild (outIter l hl e' c n).fwd (c n)
              (outIter l hl e' c n).bwd)
            rw [degree_replaceChild, degree_replaceChild, hfwd]
        | cons j u =>
            change (child (replaceChild (outIter l hl e c n).fwd (c n)
              (outIter l hl e c n).bwd) j).val u =
              (child (replaceChild (outIter l hl e' c n).fwd (c n)
              (outIter l hl e' c n).bwd) j).val u
            by_cases hjk : j = c n
            · subst j
              simp only [List.length_cons] at hu
              rw [child_replaceChild_same _ hi, child_replaceChild_same _ hi']
              exact ih (r := r - 1) (by omega) (by omega)
            · rw [child_replaceChild_of_ne _ hjk, child_replaceChild_of_ne _ hjk, hfwd]
      · have hi' : ¬(1 ≤ c n ∧ c n ≤ degree (outIter l hl e' c n).fwd) := by
          rwa [← hfwd]
        simp only [replaceChild, ite_eq_right hi', hfwd]

/-- After at least `r` outward moves, the radius-`r` marked ball is a
function of the initial forward tree and the recorded moves alone. -/
theorem ballMap_outIter (l : ℝ) (hl : 0 < l) {r n : ℕ} (hrn : r ≤ n)
    (e e' : Env) (h : e.fwd = e'.fwd) (c : ℕ → ℕ) :
    ballMap r (outIter l hl e c n) = ballMap r (outIter l hl e' c n) := by
  apply Prod.ext
  · funext u
    change (outIter l hl e c n).fwd.val u.1 = (outIter l hl e' c n).fwd.val u.1
    rw [outIter_fwd, outIter_fwd, h]
  · apply Prod.ext
    · funext u
      exact outIter_bwd_offspring l hl c hrn e e' h u.2
    · funext j
      change (outIter l hl e c n).ray j.1 = (outIter l hl e' c n).ray j.1
      rw [outIter_ray_of_lt l hl e c (by omega),
        outIter_ray_of_lt l hl e' c (by omega)]

/-- Conditional expectations on finite marked balls converge in L¹ to every
integrable real observable. -/
theorem tendsto_eLpNorm_condExp_ball (μ : Measure Env) [IsFiniteMeasure μ]
    (f : Env → ℝ) (hf : Integrable f μ) :
    Tendsto (fun r => eLpNorm (μ[f | ballFiltration r] - f) 1 μ) atTop (𝓝 0) := by
  have ht := tendsto_eLpNorm_condExp (μ := μ) (ℱ := ballFiltration) f
  rw [iSup_ballFiltration] at ht
  have hfull : μ[f | (inferInstance : MeasurableSpace Env)] =ᵐ[μ] f :=
    condExp_of_aestronglyMeasurable' le_rfl hf.1 hf
  exact ht.congr fun r => eLpNorm_congr_ae (by
    filter_upwards [hfull] with e he
    simp only [Pi.sub_apply, he])

/-- **Approximation form:** an integrable observable is arbitrarily well
approximated in L¹ by a measurable function composed with a finite marked
ball. -/
theorem exists_measurable_comp_ballMap_approx (μ : Measure Env) [IsFiniteMeasure μ]
    {f : Env → ℝ} (hf : Integrable f μ) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ (r : ℕ) (φ : BallData r → ℝ), Measurable φ ∧
      Integrable (φ ∘ ballMap r) μ ∧ eLpNorm ((φ ∘ ballMap r) - f) 1 μ < ε := by
  obtain ⟨r, hr⟩ := ((tendsto_order.1 (tendsto_eLpNorm_condExp_ball μ f hf)).2 ε hε).exists
  have hfactor : Measurable[(inferInstance : MeasurableSpace (BallData r)).comap (ballMap r)]
      (μ[f | ballFiltration r]) := stronglyMeasurable_condExp.measurable
  obtain ⟨φ, hφ, hcomp⟩ := hfactor.exists_eq_measurable_comp
  refine ⟨r, φ, hφ, ?_, ?_⟩
  · rw [← hcomp]
    exact integrable_condExp
  · rw [← hcomp]
    exact hr

end LPPMonotonicityProof.Speed
